{
  "name": "symmetrix",
  "version": "0.3.1",
  "type": "module",
  "description": "A lightweight Sass-based CSS framework with practical utility classes",
  "main": "./src/symmetrix.scss",
  "style": "./src/symmetrix.scss",
  "exports": {
    ".": "./src/symmetrix.scss",
    "./abstracts": "./src/abstracts/index.scss",
    "./base": "./src/base/index.scss",
    "./layout": "./src/layout/index.scss",
    "./elements": "./src/elements/index.scss",
    "./utils": "./src/utils/index.scss"
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "example": "sass example/style.scss example/style.css --watch"
  },
  "devDependencies": {
    "sass": "^1.97.3"
  },
  "keywords": [
    "sass",
    "scss",
    "css",
    "utility",
    "framework"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kabledev/symmetrix.git"
  },
  "bugs": {
    "url": "https://github.com/kabledev/symmetrix/issues"
  },
  "homepage": "https://github.com/kabledev/symmetrix#readme"
}
